# ---------------------------------------------------------------------------
# Game media
# ---------------------------------------------------------------------------
# The disc image and everything extracted from it are copyrighted, supplied by
# the user, and very large (7.3 GB ISO / 6.1 GB extracted). Never commit or
# redistribute them. The same goes for the C++ that codegen emits from the
# guest XEX, which is a derivative of the game binary.
*.iso
/assets/
**/assets/
**/generated/

# ---------------------------------------------------------------------------
# Upstream checkouts
# ---------------------------------------------------------------------------
# tools/reNut is tracked as a submodule (it carries the macOS port, and vendors
# the pinned SDK at thirdparty/rexglue-sdk). The other two are local-only
# checkouts: extract-xiso is a build tool, and tools/rexglue-sdk exists only to
# hold the SDK fixes branch for upstreaming - the build does not use it.
/tools/rexglue-sdk/
/tools/extract-xiso/

# ---------------------------------------------------------------------------
# Build output and scratch
# ---------------------------------------------------------------------------
/out/
**/out/
*.log
*.bak
.DS_Store
